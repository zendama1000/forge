{
  "implementer": {
    "model": "claude-opus-5",
    "timeout_sec": 3600
  },
  "investigator": {
    "model": "opus",
    "timeout_sec": 900,
    "enable_web_search": true
  },
  "layer_1_test": {
    "default_timeout_sec": 200
  },
  "layer_2": {
    "auto_run_after_all_tasks": true,
    "fail_creates_task": true,
    "default_timeout_sec": 120,
    "max_timeout_sec": 300,
    "setup_commands": []
  },
  "task_planner": {
    "model": "opus",
    "timeout_sec": 0
  },
  "checklist_verifier": {
    "enabled": false,
    "model": "opus",
    "timeout_sec": 300
  },
  "server": {
    "start_command": "none",
    "health_check_url": "none",
    "startup_timeout_sec": 60
  },
  "safety": {
    "max_files_per_task": 30,
    "max_files_hard_limit": 60,
    "auto_revert_on_regression": false,
    "auto_commit_per_phase": true,
    "regression_failure_policy": "warn_and_continue"
  },
  "evidence_da": {
    "enabled": false,
    "model": "opus",
    "timeout_sec": 300,
    "fail_threshold": 2
  },
  "assertions": {
    "enabled": true
  },
  "agent_effort": {
    "implementer": "medium",
    "investigator": "xhigh",
    "evidence_da": "high"
  },
  "layer_3": {
    "enabled": true,
    "judge_model": "opus",
    "judge_timeout_sec": 300,
    "max_judge_calls_per_session": 20,
    "default_timeout_sec": 120,
    "fail_creates_task": true,
    "agent_flow_timeout": 900,
    "max_agent_calls": 30,
    "judge_model_coherence": "opus",
    "coherence_retry_count": 1
  },
  "safety_profiles": {
    "setup": {
      "max_files_per_task": 30,
      "max_files_hard_limit": 60,
      "disallowed_tools": "WebSearch,WebFetch"
    },
    "implementation": {
      "max_files_per_task": 30,
      "max_files_hard_limit": 60,
      "disallowed_tools": "WebSearch,WebFetch"
    },
    "documentation": {
      "max_files_per_task": 5,
      "max_files_hard_limit": 10,
      "disallowed_tools": "WebSearch,WebFetch"
    }
  },
  "qa_evaluator": {
    "enabled": true,
    "model": "opus",
    "timeout_sec": 300,
    "max_qa_failures_per_task": 3
  },
  "sprint_contract": {
    "enabled": false,
    "model": "opus",
    "timeout_sec": 120,
    "human_review_on_infeasible": true
  },
  "context_strategy": {
    "default": "reset",
    "per_agent": {
      "implementer": "reset",
      "investigator": "reset",
      "evidence_da": "reset",
      "qa_evaluator": "reset"
    }
  },
  "browser_testing": {
    "enabled": true,
    "playwright_mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "default_timeout_sec": 120,
    "model": "opus",
    "headless": true
  },
  "best_of_n": {
    "enabled": false,
    "n": 2,
    "trigger_fail_count": 2,
    "selection": "judge",
    "judge_model": "opus",
    "judge_timeout_sec": 240,
    "judge_max_patch_lines": 400
  },
  "hot_reload": {
    "models": true
  }
}
