{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ux-scenarios",
  "type": "object",
  "required": ["scenarios"],
  "properties": {
    "criteria_fingerprint": {
      "type": "string",
      "description": "生成元 criteria の md5（ハーネスが生成後に追記 — 別プロジェクト残骸の再利用防止）"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["scenario_id", "user_goal", "entry_url", "action_budget", "viewport", "success_signal"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^UX-S-[0-9]+$" },
          "user_goal": {
            "type": "string",
            "description": "ユーザー語彙のゴール。実装用語（コンポーネント名・機能ID・ファイル名・『〜ボタン』等の答え）を含めてはならない"
          },
          "entry_url": { "type": "string" },
          "action_budget": { "type": "integer", "minimum": 1, "maximum": 30 },
          "viewport": { "enum": ["mobile", "desktop"] },
          "success_signal": {
            "type": "string",
            "description": "ユーザー主観で完遂と判断できる状態の記述"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
