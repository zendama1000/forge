{
  "type": "object",
  "properties": {
    "source_criteria": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "exit_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "expect": {
                  "type": "string"
                },
                "level": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "walking_skeleton",
                    "standard"
                  ],
                  "description": "walking_skeleton = 実ユーザーシナリオ1本の end-to-end 検証（各 dev-phase に1本以上必須）"
                },
                "requires": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "type",
                "description"
              ]
            }
          }
        },
        "required": [
          "id",
          "goal"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "task_type": {
            "type": "string"
          },
          "dev_phase_id": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "validation": {
            "type": "object",
            "properties": {
              "layer_1": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "expect": {
                    "type": "string"
                  },
                  "timeout_sec": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 3600
                  }
                },
                "required": [
                  "command",
                  "expect"
                ]
              },
              "layer_2": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "expect": {
                    "type": "string"
                  },
                  "timeout_sec": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 3600
                  },
                  "requires": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "必要な環境能力: server | env:VAR | cmd:NAME | file:PATH | browser | network | docker"
                  },
                  "deferred": {
                    "type": "boolean",
                    "description": "true = 環境制約により自律実行不能。fix タスクを生成せず品質債務台帳に記録して Phase 4 へ繰延"
                  },
                  "deferred_reason": {
                    "type": "string"
                  }
                }
              },
              "layer_3": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "strategy": {
                      "type": "string",
                      "enum": [
                        "structural",
                        "api_e2e",
                        "llm_judge",
                        "cli_flow",
                        "context_injection",
                        "agent_flow",
                        "browser"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "definition": {
                      "type": "object",
                      "properties": {
                        "command": {
                          "type": "string"
                        },
                        "expected_schema": {
                          "type": "object"
                        },
                        "judge_criteria": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "success_threshold": {
                          "type": "number"
                        },
                        "context_file": {
                          "type": "string"
                        },
                        "verify_command": {
                          "type": "string"
                        },
                        "steps": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "step_id": {
                                "type": "string"
                              },
                              "prompt_template": {
                                "type": "string"
                              },
                              "agent_file": {
                                "type": "string",
                                "description": "--system-prompt に注入するエージェント定義 .md（省略可）"
                              },
                              "model": {
                                "type": "string"
                              },
                              "subagent_files": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": ".claude/agents/*.md のパス（PROJECT_ROOT 相対 or 絶対）。--agents インライン定義に変換され -p モードで Task 委譲が可能になる"
                              },
                              "expected_outputs": {
                                "type": "array"
                              },
                              "context_from_steps": {
                                "type": "array"
                              },
                              "timeout_sec": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "step_id"
                            ]
                          }
                        },
                        "coherence_checks": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "source_step": {
                                "type": "string"
                              },
                              "target_step": {
                                "type": "string"
                              },
                              "check_type": {
                                "type": "string",
                                "enum": [
                                  "structural",
                                  "semantic",
                                  "hybrid"
                                ]
                              }
                            }
                          }
                        }
                      }
                    },
                    "requires": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "blocking": {
                      "type": "boolean"
                    },
                    "deferred": {
                      "type": "boolean",
                      "description": "true = 環境制約により自律実行不能。fix タスクを生成せず品質債務台帳に記録して Phase 4 へ繰延"
                    },
                    "deferred_reason": {
                      "type": "string"
                    },
                    "timeout_sec": {
                      "type": "number",
                      "minimum": 10,
                      "maximum": 3600
                    },
                    "instructions": {
                      "type": "string",
                      "description": "browser strategy 用: browser-tester エージェントへの自然言語の操作/検証指示"
                    }
                  },
                  "required": [
                    "id",
                    "strategy",
                    "description",
                    "definition"
                  ]
                }
              },
              "checks": {
                "type": "array",
                "description": "v2 型付き検証 (batch#8)。layer に1件でもあればその layer は v2 が権威 (legacy command は無視)",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "layer": {
                      "type": "integer",
                      "enum": [
                        1,
                        2,
                        3
                      ]
                    },
                    "verb": {
                      "type": "string",
                      "enum": [
                        "file_exists",
                        "grep_ref",
                        "run_test",
                        "http_check",
                        "effect_smoke",
                        "agent_flow",
                        "raw_shell"
                      ]
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "file_exists/grep_ref: WORK_DIR 相対。絶対/../グロブ禁止"
                    },
                    "pattern": {
                      "type": "string",
                      "description": "grep_ref: ERE"
                    },
                    "expect_absent": {
                      "type": "boolean",
                      "description": "grep_ref: true=全 paths に不在で PASS"
                    },
                    "runner": {
                      "type": "string",
                      "enum": [
                        "vitest",
                        "jest",
                        "pytest",
                        "playwright",
                        "node-test",
                        "go-test",
                        "cargo-test",
                        "tsc",
                        "eslint",
                        "biome"
                      ]
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "run_test: argv 要素。クォート/シェル演算子禁止"
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST",
                        "PUT",
                        "PATCH",
                        "DELETE",
                        "HEAD"
                      ]
                    },
                    "url_path": {
                      "type": "string",
                      "description": "http_check: server base URL への相対"
                    },
                    "url": {
                      "type": "string",
                      "description": "http_check: 絶対 URL (url_path より優先)"
                    },
                    "body": {
                      "type": "string"
                    },
                    "expect_status": {
                      "type": "integer",
                      "description": "http_check: 既定 200"
                    },
                    "body_jq": {
                      "type": "string",
                      "description": "http_check: レスポンスへの jq -e 式"
                    },
                    "argv": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "effect_smoke: 実行 argv (シェル解釈なし)"
                    },
                    "expect": {
                      "type": "object",
                      "properties": {
                        "exit_code": {
                          "type": "integer"
                        },
                        "stdout_contains": {
                          "type": "string"
                        },
                        "creates_files": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "definition": {
                      "type": "object",
                      "description": "agent_flow: layer_3 agent_flow definition と同形 (steps[] 等)"
                    },
                    "shell": {
                      "type": "string",
                      "description": "raw_shell: 最終手段。実行毎に weak_validation 債務記録"
                    },
                    "reason": {
                      "type": "string",
                      "description": "raw_shell: 必須。verb で表現できない理由"
                    },
                    "requires": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "server|env:V|cmd:N|file:P|browser|network|docker。layer:1 は cmd:/file: のみ可"
                    },
                    "timeout_sec": {
                      "type": "number",
                      "minimum": 10,
                      "maximum": 3600
                    },
                    "deferred": {
                      "type": "boolean"
                    },
                    "deferred_reason": {
                      "type": "string"
                    },
                    "blocking": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "layer",
                    "verb"
                  ]
                }
              }
            },
            "required": []
          },
          "l1_criteria_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "l2_criteria_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_behaviors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allows_test_edits": {
            "type": "boolean",
            "description": "true の場合このタスクは既存テストファイルの改変を許可される（テスト聖域化の個別解除。l2fix/l3fix はデフォルト true）"
          },
          "replaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "このタスクが置換する旧ファイル/シンボル名。非空なら L1 に grep 配線検証（旧名残存なし + 新名被参照あり）が必須（機械ゲート対象）"
          }
        },
        "required": [
          "task_id",
          "description",
          "task_type",
          "dev_phase_id",
          "status",
          "validation",
          "l1_criteria_refs"
        ]
      }
    },
    "scope_coverage": {
      "type": "object",
      "properties": {
        "theme_elements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "element": {
                "type": "string"
              },
              "mapped_tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "element",
              "mapped_tasks"
            ]
          }
        },
        "coverage_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "theme_elements",
        "coverage_complete"
      ]
    },
    "excluded_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "element",
          "reason"
        ]
      }
    }
  },
  "required": [
    "source_criteria",
    "generated_at",
    "phases",
    "tasks"
  ]
}
